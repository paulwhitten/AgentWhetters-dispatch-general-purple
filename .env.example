# Environment variables for AgentWhetters General Purple Agent
# Copy this file to .env and fill in your values

# --- Option 1: OpenAI direct ---
# export OPENAI_API_KEY=sk-...
# export OPENAI_BASE_URL=              # optional, for proxies

# --- Option 2: Azure OpenAI ---
# export AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# export AZURE_OPENAI_API_VERSION=2025-04-01-preview
# export OPENAI_API_KEY=your-azure-key

# Model deployment names (Azure deployment names or OpenAI model names)
export AGENT_MODEL=gpt-5.4
export AGENT_MID_MODEL=gpt-4.1
export AGENT_CHEAP_MODEL=gpt-4o-mini

# Logging
export AGENT_LOG_LEVEL=INFO
