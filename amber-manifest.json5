{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
      azure_openai_endpoint: { type: "string" },
      azure_openai_api_version: { type: "string" },
      anthropic_api_key: { type: "string", secret: true },
      gemini_api_key: { type: "string", secret: true },
      model_name: { type: "string" },
      cheap_model_name: { type: "string" },
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },

  program: {
    image: "ghcr.io/paulwhitten/agentwhetters-dispatch-general-purple:1.0.2",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9009",

    env: {
      PYTHONUNBUFFERED: "1",
      AGENT_MODEL: "${config.model_name}",
      AGENT_CHEAP_MODEL: "${config.cheap_model_name}",
      OPENAI_API_KEY: "${config.openai_api_key}",
      AZURE_OPENAI_ENDPOINT: "${config.azure_openai_endpoint}",
      AZURE_OPENAI_API_VERSION: "${config.azure_openai_api_version}",
      ANTHROPIC_API_KEY: "${config.anthropic_api_key}",
      GOOGLE_API_KEY: "${config.gemini_api_key}",
    },

    network: {
      endpoints: [
        { name: "endpoint", port: 9009 },
      ],
    },
  },
}
