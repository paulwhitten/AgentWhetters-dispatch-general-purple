{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },

  program: {
    image: "ghcr.io/paulwhitten/agentwhetters-dispatch-general-purple:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9009",

    env: {
      PYTHONUNBUFFERED: "1",
      AGENT_MODEL: "gpt-5.4",
      AGENT_CHEAP_MODEL: "gpt-4o-mini",
      OPENAI_API_KEY: "${config.openai_api_key}",
    },

    network: {
      endpoints: [
        { name: "endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },

  exports: {
    a2a: "a2a",
  },
}
